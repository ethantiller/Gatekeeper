{
  "description": "Send Codex sessions, prompts and tool calls to the local Gatekeeper server. PreToolUse fails closed: if the server is down or errors, the tool call is denied.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "curl --silent --show-error --fail --max-time 8 --request POST --header \"Content-Type: application/json\" --header \"X-Gatekeeper-Token: $(cat ~/.gatekeeper/token)\" --data-binary @- http://127.0.0.1:8787/hooks/codex/session-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl --silent --show-error --fail --max-time 8 --request POST --header \"Content-Type: application/json\" --header \"X-Gatekeeper-Token: $(cat ~/.gatekeeper/token)\" --data-binary @- http://127.0.0.1:8787/hooks/codex/prompt || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "curl --silent --show-error --fail --max-time 325 --request POST --header \"Content-Type: application/json\" --header \"X-Gatekeeper-Token: $(cat ~/.gatekeeper/token)\" --data-binary @- http://127.0.0.1:8787/hooks/codex/before-tool || echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Gatekeeper server is not reachable, so this action was blocked. Ask the user to start it with: uv run python -m gatekeeper.server.main\"}}'",
            "timeout": 330
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "curl --silent --show-error --fail --max-time 8 --request POST --header \"Content-Type: application/json\" --header \"X-Gatekeeper-Token: $(cat ~/.gatekeeper/token)\" --data-binary @- http://127.0.0.1:8787/hooks/codex/after-tool || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
