			{
				"matcher": "^(Bash|Write|Edit|Read|WebFetch|mcp__gatekeeper__fixture_echo)$",
				"hooks": [
					{
						"type": "command",
						"command": "curl",
						"args": [
							"--silent",
							"--show-error",
							"--max-time",
							"5",
							"--request",
							"POST",
							"--header",
							"Content-Type: application/json",
							"--data-binary",
							"@-",
							"http://127.0.0.1:8765/hooks"
						]
